<%= form_with model: bill, class: "space-y-5" do |f| %>
  <div>
    <%= f.label :title, class: "block text-sm font-medium mb-1" %>
    <%= f.text_field :title, class: "w-full rounded-lg border px-3 py-2" %>
    <% bill.errors.full_messages_for(:title).each do |msg| %>
      <p class="text-sm text-red-600 mt-1"><%= msg %></p>
    <% end %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= f.label :amount, "Amount", class: "block text-sm font-medium mb-1" %>
      <%= f.number_field :amount, step: "0.01", class: "w-full rounded-lg border px-3 py-2" %>
      <% bill.errors.full_messages_for(:amount_cents).each do |msg| %>
        <p class="text-sm text-red-600 mt-1"><%= msg %></p>
      <% end %>
    </div>

    <div>
      <%= f.label :due_day, "Due day (1–31)", class: "block text-sm font-medium mb-1" %>
      <%= f.number_field :due_day, min: 1, max: 31, class: "w-full rounded-lg border px-3 py-2" %>
      <% bill.errors.full_messages_for(:due_day).each do |msg| %>
        <p class="text-sm text-red-600 mt-1"><%= msg %></p>
      <% end %>
    </div>
  </div>

  <div class="flex items-center gap-2">
    <%= f.check_box :active, class: "rounded border" %>
    <%= f.label :active, "Active", class: "text-sm font-medium" %>
  </div>

  <div>
    <%= f.label :last_paid_on, "Last paid on (optional)", class: "block text-sm font-medium mb-1" %>
    <%= f.date_field :last_paid_on, class: "w-full rounded-lg border px-3 py-2" %>
  </div>

  <div class="flex flex-col sm:flex-row gap-2 sm:items-center">
    <%= f.submit class: "w-full sm:w-auto rounded-lg bg-slate-900 text-white px-4 py-2 text-sm font-medium hover:bg-slate-800" %>
    <%= link_to "Cancel", recurring_bills_path, class: "w-full sm:w-auto rounded-lg border px-4 py-2 text-center text-sm hover:bg-gray-50" %>
  </div>

<% end %>
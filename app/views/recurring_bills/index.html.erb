<div class="flex items-center justify-between mb-8">
  <h1 class="text-3xl font-semibold">Recurring Bills</h1>

  <%= link_to "+ Add New Bill", new_recurring_bill_path,
        class: "inline-flex items-center justify-center rounded-lg bg-slate-900 text-white px-4 py-2 text-sm font-medium hover:bg-slate-800" %>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">

  <!-- LEFT COLUMN -->
  <div class="space-y-6">
    <!-- Total Bills card -->
    <div class="rounded-2xl bg-slate-900 text-white p-6 shadow-sm">
      <div class="flex items-start justify-between">
        <div class="space-y-2">
          <div class="text-sm text-slate-300">Total Bills</div>
          <div class="text-4xl font-semibold tracking-tight">
            <%= number_to_currency(@total_bills_cents.to_i / 100.0) %>
          </div>
        </div>

        <!-- simple icon -->
        <div class="rounded-xl bg-white/10 p-3">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white/90" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M9 14h6m-6-4h6m-7 10h8a2 2 0 002-2V6a2 2 0 00-2-2H8a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
      </div>
    </div>

    <!-- Summary card -->
    <div class="rounded-2xl border bg-white p-6 shadow-sm">
      <div class="text-lg font-semibold mb-4">Summary</div>

      <div class="space-y-4 text-sm">
        <div class="flex items-center justify-between">
          <div class="text-gray-600">Paid Bills</div>
          <div class="font-semibold">
            <%= @paid_count.to_i %>
            <span class="text-gray-500 font-normal">
              (<%= number_to_currency(@paid_total_cents.to_i / 100.0) %>)
            </span>
          </div>
        </div>

        <div class="h-px bg-gray-100"></div>

        <div class="flex items-center justify-between">
          <div class="text-gray-600">Total Upcoming</div>
          <div class="font-semibold">
            <%= @upcoming_count.to_i %>
            <span class="text-gray-500 font-normal">
              (<%= number_to_currency(@upcoming_total_cents.to_i / 100.0) %>)
            </span>
          </div>
        </div>

        <div class="h-px bg-gray-100"></div>

        <div class="flex items-center justify-between">
          <div class="text-red-600">Due Soon</div>
          <div class="font-semibold text-red-600">
            <%= @due_soon_count.to_i %>
            <span class="text-red-500 font-normal">
              (<%= number_to_currency(@due_soon_total_cents.to_i / 100.0) %>)
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- RIGHT COLUMN (TABLE) -->
  <div class="lg:col-span-2 rounded-2xl border bg-white p-6 shadow-sm overflow-hidden">
    <!-- Toolbar -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-5">
      <!-- Search -->
      <%= form_with url: recurring_bills_path, method: :get, class: "w-full sm:max-w-md" do %>
        <div class="relative">
          <%= text_field_tag :q, params[:q],
                placeholder: "Search bills",
                class: "w-full rounded-lg border px-4 py-2 pr-10 text-sm focus:outline-none focus:ring-2 focus:ring-slate-200" %>

          <div class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-gray-400">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M21 21l-4.35-4.35m1.85-5.15a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
        </div>

        <%# keep sort when searching %>
        <%= hidden_field_tag :sort, params[:sort] if params[:sort].present? %>
      <% end %>

      <!-- Sort -->
      <div class="flex items-center gap-3 justify-between sm:justify-end">
        <div class="text-sm text-gray-500 whitespace-nowrap">Sort by</div>

        <%= form_with url: recurring_bills_path, method: :get do %>
          <%# keep q when sorting %>
          <%= hidden_field_tag :q, params[:q] if params[:q].present? %>

          <%= select_tag :sort,
                options_for_select(
                  [
                    ["Latest", "latest"],
                    ["Amount (high to low)", "amount_desc"],
                    ["Amount (low to high)", "amount_asc"],
                    ["Due day", "due_day"]
                  ],
                  (params[:sort].presence || "latest")
                ),
                onchange: "this.form.submit()",
                class: "rounded-lg border px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-slate-200" %>
        <% end %>
      </div>
    </div>

    <!-- Table -->
    <div class="overflow-x-auto">
      <table class="min-w-full text-sm">
        <thead class="text-gray-500">
          <tr class="border-b">
            <th class="text-left font-medium py-3 pr-3">Bill Title</th>
            <th class="text-left font-medium py-3 pr-3">Due Date</th>
            <th class="text-right font-medium py-3">Amount</th>
          </tr>
        </thead>

        <tbody class="divide-y">
          <% if @bills.any? %>
            <% @bills.each do |bill| %>
              <tr class="hover:bg-gray-50">
                <!-- Title -->
                <td class="py-4 pr-3">
                  <div class="flex items-center gap-3 min-w-0">
                    <!-- avatar circle -->
                    <div class="h-10 w-10 rounded-full bg-slate-100 flex items-center justify-center shrink-0">
                      <span class="text-slate-700 font-semibold text-sm">
                        <%= bill.title.to_s.first(1).upcase %>
                      </span>
                    </div>

                    <div class="min-w-0">
                      <div class="font-semibold text-slate-900 truncate">
                        <%= link_to bill.title, recurring_bill_path(bill), class: "hover:underline" %>
                      </div>
                      <div class="text-xs text-gray-500">
                        <%= bill.active? ? "Active" : "Inactive" %>
                      </div>
                    </div>
                  </div>
                </td>

                <!-- Due Date -->
                <td class="py-4 pr-3">
                  <div class="flex items-center gap-2">
                    <span class="text-sm text-teal-700 font-medium"><%= bill.due_label %></span>

                    <% if bill.overdue? %>
                      <span class="inline-flex items-center rounded-full bg-red-50 px-2 py-1 text-xs font-medium text-red-700">
                        !
                      </span>
                    <% else %>
                      <span class="inline-flex items-center rounded-full bg-emerald-50 px-2 py-1 text-xs font-medium text-emerald-700">
                        ✓
                      </span>
                    <% end %>
                  </div>
                </td>

                <!-- Amount -->
                <td class="py-4 text-right font-semibold whitespace-nowrap">
                  <span class="<%= bill.overdue? ? 'text-red-600' : 'text-slate-900' %>">
                    <%= number_to_currency(bill.amount) %>
                  </span>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="3" class="py-10 text-center text-gray-500">
                No recurring bills yet.
                <%= link_to "Create one", new_recurring_bill_path, class: "underline" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
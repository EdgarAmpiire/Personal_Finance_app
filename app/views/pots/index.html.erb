<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
  <h1 class="text-3xl font-semibold">Pots</h1>

  <%= link_to "+ Add New Pot", new_pot_path,
        class: "inline-flex justify-center rounded-lg bg-slate-900 text-white px-4 py-2 text-sm font-medium hover:bg-slate-800" %>
</div>

<% if @pots.any? %>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <% @pots.each do |pot| %>
      <div class="rounded-2xl border bg-white p-6 shadow-sm">
        <div class="flex items-start justify-between gap-4">
          <div class="min-w-0">
            <div class="text-lg font-semibold truncate">
              <%= link_to pot.name, pot_path(pot), class: "hover:underline" %>
            </div>

            <div class="mt-2 text-sm text-gray-600 space-y-1">
              <div><span class="font-medium">Saved:</span> <%= number_to_currency(pot.saved) %></div>
              <div><span class="font-medium">Target:</span> <%= number_to_currency(pot.target) %></div>
            </div>
          </div>

          <div class="flex shrink-0 gap-2">
            <%= link_to "Edit", edit_pot_path(pot), class: "rounded-lg border px-3 py-2 text-sm hover:bg-gray-50" %>
            <%= button_to "Delete", pot_path(pot), method: :delete,
                  class: "rounded-lg bg-red-600 text-white px-3 py-2 text-sm hover:bg-red-700",
                  data: { turbo_confirm: "Delete this pot?" } %>
          </div>
        </div>

        <div class="mt-5">
          <div class="flex items-center justify-between text-xs text-gray-600 mb-2">
            <span>Progress</span>
            <span><%= pot.progress_percent %>%</span>
          </div>

          <div class="h-2 w-full rounded-full bg-gray-200 overflow-hidden">
            <div class="h-full bg-slate-900" style="width: <%= pot.progress_percent %>%;"></div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="rounded-2xl border bg-white p-8">
    <p class="text-gray-600">No pots yet. Create one to start saving toward goals.</p>
  </div>
<% end %>
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
  <div>
    <h1 class="text-3xl font-semibold"><%= @pot.name %></h1>
    <p class="text-sm text-gray-600">Savings pot</p>
  </div>

  <div class="flex gap-2">
    <%= link_to "Edit", edit_pot_path(@pot), class: "rounded-lg border px-4 py-2 text-sm hover:bg-gray-50" %>
    <%= button_to "Delete", pot_path(@pot), method: :delete,
          class: "rounded-lg bg-red-600 text-white px-4 py-2 text-sm hover:bg-red-700",
          data: { turbo_confirm: "Delete this pot?" } %>
  </div>
</div>

<div class="rounded-2xl border bg-white p-6 shadow-sm max-w-3xl">
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <div class="rounded-xl bg-gray-50 p-4">
      <div class="text-xs text-gray-500">Saved</div>
      <div class="text-xl font-semibold mt-1"><%= number_to_currency(@pot.saved) %></div>
    </div>

    <div class="rounded-xl bg-gray-50 p-4">
      <div class="text-xs text-gray-500">Target</div>
      <div class="text-xl font-semibold mt-1"><%= number_to_currency(@pot.target) %></div>
    </div>

    <div class="rounded-xl bg-gray-50 p-4">
      <div class="text-xs text-gray-500">Progress</div>
      <div class="text-xl font-semibold mt-1"><%= @pot.progress_percent %>%</div>
    </div>
  </div>

  <div class="mt-6">
    <div class="flex items-center justify-between text-xs text-gray-600 mb-2">
      <span>Progress bar</span>
      <span><%= @pot.progress_percent %>%</span>
    </div>

    <div class="h-2 w-full rounded-full bg-gray-200 overflow-hidden">
      <div class="h-full bg-slate-900" style="width: <%= @pot.progress_percent %>%;"></div>
    </div>
  </div>

  <div class="mt-6">
    <%= link_to "Back to pots", pots_path, class: "text-sm underline" %>
  </div>
</div>